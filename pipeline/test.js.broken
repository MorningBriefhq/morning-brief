// Morning Briefing pipeline — unit + integration tests.
// Run: node --test pipeline/test.js
// Uses in-memory SQLite (node:sqlite) shaped like D1, and mock providers.
// Does not touch the network.

import { test } from "node:test";
import assert from "node:assert/strict";
import { DatabaseSync } from "node:sqlite";
import { readFile } from "node:fs/promises";
import path from "node:path";
import { fileURLToPath } from "node:url";

import { renderTemplate } from "./lib/render.js";
import { runDateET, etHour, dateLongET } from "./lib/time.js";
import { signToken, verifyToken } from "./lib/sign.js";
import { MockNewsProvider } from "./lib/news.js";
import { MockSummarizer, WorkersAISummarizer } from "./lib/summarize.js";
import { MockMarketProvider } from "./lib/market.js";
import { MOCK_ARTICLES, MOCK_MARKET } from "./lib/mock-data.js";
import {
  runMarket,
  runAssemble,
  runStage,
} from "./stages.js";

const root = path.dirname(path.dirname(fileURLToPath(import.meta.url)));
const nowSec = () => Math.floor(Date.now() / 1000);

function openDB() {
  const sqlite = new DatabaseSync(":memory:");
  const wrap = (stmt) => ({
    bind: (...p) => ({
      first: () => stmt.get(...p) ?? null,
      all: () => ({ results: stmt.all(...p) }),
      run: () => {
        const r = stmt.run(...p);
        return { success: true, meta: { changes: r.changes ?? 0 } };
      },
    }),
    first: () => stmt.get() ?? null,
    all: () => ({ results: stmt.all() }),
    run: () => {
      const r = stmt.run();
      return { success: true, meta: { changes: r.changes ?? 0 } };
    },
  });
  return {
    prepare: (sql) => wrap(sqlite.prepare(sql)),
    exec: (sql) => sqlite.exec(sql),
  };
}

async function freshDB() {
  const db = openDB();
  const strip = (t) => t.split("\n").filter((l) => !l.trimStart().startsWith("--")).join("\n");
  for (const f of ["schema.sql", "pipeline/schema-additions.sql"]) {
    const sql = strip(await readFile(path.join(root, f), "utf8"));
    for (const s of sql.split(";")) if (s.trim()) db.exec(s);
  }
  return db;
}

async function seedUser(db, { id, email, name, tickers, unsub = false }) {
  await db.prepare("INSERT INTO users (id, email, first_name, plan, created_at, unsubscribed_at) VALUES (?, ?, ?, 'free', ?, ?)")
    .bind(id, email, name, nowSec(), unsub ? nowSec() : null).run();
  for (const t of tickers)
    await db.prepare("INSERT INTO user_tickers (user_id, ticker, added_at) VALUES (?, ?, ?)")
      .bind(id, t, nowSec()).run();
}

const COMPANIES = new Map([["NVDA", "NVIDIA"], ["AAPL", "Apple Inc."], ["KO", "Coca-Cola"]]);
const TEMPLATE = "<p>Hi {{first_name}}!</p>{{#each your_stocks}}<b>{{index}}. {{ticker}}</b>: {{summary}}{{/each}}{{#each missing}}x{{/each}}";

// ---------- renderer ----------
test("render: scalars, loops, index, empty lists, escaping", () => {
  const out = renderTemplate(TEMPLATE, {
    first_name: "Pat & <Co>",
    your_stocks: [{ ticker: "NVDA", summary: "Up <b>big</b>" }],
    missing: [],
  });
  assert.match(out, /Hi Pat &amp; &lt;Co&gt;!/);
  assert.match(out, /<b>1\. NVDA<\/b>: Up &lt;b&gt;big&lt;\/b&gt;/);
  assert.doesNotMatch(out, /\{\{/);
});

test("render: strips HTML comments (doc {{#each}} examples never match)", () => {
  const tpl = "<!-- {{#each foo}} {{bar}} {{/each}} --><p>{{first_name}}</p>{{#each foo}}[{{bar}}]{{/each}}";
  const out = renderTemplate(tpl, { first_name: "Zed", foo: [{ bar: "one" }, { bar: "two" }] });
  assert.equal(out, "<p>Zed</p>[one][two]");
});

test("render: dark theme inlines the dark palette server-side", () => {
  const tpl = '<p style="color:#101418;background:#ffffff">Hi {{first_name}}</p>';
  const out = renderTemplate(tpl, { first_name: "Pat" }, { theme: "dark" });
  assert.equal(out, '<p style="color:#e8edf4;background:#152a44">Hi Pat</p>');
  assert.doesNotMatch(out, /#101418|#ffffff/i);
});

test("render: absent or unknown theme renders the light palette", () => {
  const tpl = '<p style="color:#101418">Hi</p>';
  assert.equal(renderTemplate(tpl, {}), tpl);
  assert.equal(renderTemplate(tpl, {}, { theme: "midnight" }), tpl);
  assert.equal(renderTemplate(tpl, {}, { theme: "light" }), tpl);
});

// ---------- time ----------
test("time: ET anchoring across DST", () => {
  // Winter (EST, UTC-5): 09:30 UTC = 04:30 ET
  assert.equal(runDateET(new Date("2026-01-15T09:30:00Z")), "2026-01-15");
  assert.equal(etHour(new Date("2026-01-15T09:30:00Z")), 4);
  // Summer (EDT, UTC-4): 08:30 UTC = 04:30 ET
  assert.equal(runDateET(new Date("2026-07-15T08:30:00Z")), "2026-07-15");
  assert.equal(etHour(new Date("2026-07-15T08:30:00Z")), 4);
  // Late UTC = previous ET day: 03:00 UTC = 23:00 ET prior day
  assert.equal(runDateET(new Date("2026-07-15T03:00:00Z")), "2026-07-14");
  assert.equal(dateLongET(new Date("2026-10-12T12:00:00Z")), "Monday, October 12, 2026");
});

// ---------- signing ----------
test("sign: round-trip, tamper rejection, wrong secret", async () => {
  const tok = await signToken("user-123", "s3cret");
  assert.equal(await verifyToken(tok, "s3cret"), "user-123");
  assert.equal(await verifyToken(tok + "x", "s3cret"), null);
  assert.equal(await verifyToken(tok, "wrong"), null);
  assert.equal(await verifyToken("garbage", "s3cret"), null);
});

// ---------- providers ----------
test("mock news: articles for known tickers, empty for quiet ones", async () => {
  const n = new MockNewsProvider(MOCK_ARTICLES);
  assert.ok((await n.companyNews("NVDA")).length > 0);
  assert.deepEqual(await n.companyNews("KO"), []);
});

test("mock summarizer: deterministic 2-3 sentence extract", async () => {
  const s = new MockSummarizer();
  const out = await s.summarize("NVDA", "NVIDIA", MOCK_ARTICLES.NVDA);
  assert.ok(out.length > 20);
  assert.equal(await s.summarize("NVDA", "NVIDIA", MOCK_ARTICLES.NVDA), out);
});

test("workers-ai summarizer: uses binding, returns trimmed text", async () => {
  let sawModel = null;
  const fakeAI = {
    run: async (model, opts) => {
      sawModel = model;
      assert.ok(opts.messages.length === 2);
      assert.ok(opts.messages[1].content.includes("NVDA"));
      return { response: "  Nvidia beat expectations on data-center revenue.  " };
    },
  };
  const s = new WorkersAISummarizer(fakeAI);
  const out = await s.summarize("NVDA", "NVIDIA Corp", MOCK_ARTICLES.NVDA);
  assert.equal(out, "Nvidia beat expectations on data-center revenue.");
  assert.equal(sawModel, "@cf/meta/llama-3.3-70b-instruct-fp8-fast");
});

test("workers-ai summarizer: throws on empty response", async () => {
  const s = new WorkersAISummarizer({ run: async () => ({ response: "  " }) });
  await assert.rejects(() => s.summarize("NVDA", "NVIDIA", MOCK_ARTICLES.NVDA));
});

test("mock market: sections shaped for the template", async () => {
  const m = new MockMarketProvider(MOCK_MARKET);
  const top = await m.topNews("2026-10-12");
  assert.ok(top.length >= 4 && top[0].headline && top[0].summary);
  const bb = await m.beforeBell("2026-10-12");
  assert.ok(bb.some((r) => r.label === "Futures"));
  const cal = await m.calendar("2026-10-12");
  assert.ok(cal.earnings.length > 0 && cal.econ.length > 0);
});

// ---------- stages ----------
  assert.equal(calls, 1);
  await assert.rejects(runStage(db, "2026-10-12", "bad", async () => { throw new Error("boom"); }, nowSec));
  const row = await db.prepare("SELECT status FROM pipeline_runs WHERE run_date='2026-10-12' AND stage='bad'").first();
  assert.equal(row.status, "failed");
});

test("assemble: one brief for all, skips unsubscribed + already-sent", async () => {
  const db = await freshDB();
  await seedUser(db, { id: "u1", email: "pat@x.com", name: "Pat" });
  await seedUser(db, { id: "u2", email: "out@x.com", name: "Out", unsub: true });
  await runMarket({ db, market: new MockMarketProvider(MOCK_MARKET), runDate: "2026-10-12", nowSec });

  const sent = [];
  const sender = { send: async (m) => (sent.push(m), { ok: true }) };
  const templateText = await readFile(path.join(root, "email", "template.html"), "utf8");
  const base = {
    db, sender, runDate: "2026-10-12", dateLong: "Monday, October 12, 2026",
    origin: "https://example.com", productName: "Morning Briefing",
    sessionSecret: "test-secret", templateText, nowSec,
  };
  const r1 = await runAssemble(base);
  assert.equal(r1.users, 1); // unsubscribed excluded
  assert.equal(r1.sent, 1);
  const html = sent[0].html;
  assert.match(html, /Good morning, Pat/);
  // No personalization: everyone gets the same brief, no YOUR STOCKS section
  assert.doesNotMatch(html, /YOUR STOCKS/);
  assert.match(html, /not investment advice/i);
  assert.match(html, /\/api\/unsubscribe\?token=[A-Za-z0-9\-_.]+/);
  assert.doesNotMatch(html, /\{\{/);
  assert.ok(sent[0].subject.length > 20); // informative subject, not just the date
  assert.doesNotMatch(sent[0].subject, /^Morning Briefing: Monday/); // no longer date-only

  const r2 = await runAssemble(base); // idempotent
  assert.equal(r2.sent, 0);
  assert.equal(r2.skipped, 1);
});

test("assemble: dark-theme user gets the dark palette, light user gets light", async () => {
  const db = await freshDB();
  await seedUser(db, { id: "u1", email: "pat@x.com", name: "Pat", tickers: ["NVDA"] });
  await db.prepare("INSERT INTO users (id, email, first_name, plan, theme, created_at) VALUES (?, ?, ?, 'free', 'dark', ?)")
    .bind("u2", "dark@x.com", "Dark", nowSec()).run();
  await runMarket({ db, market: new MockMarketProvider(MOCK_MARKET), runDate: "2026-10-12", nowSec });

  const sent = [];
  const sender = { send: async (m) => (sent.push(m), { ok: true }) };
  const templateText = await readFile(path.join(root, "email", "template.html"), "utf8");
  const r = await runAssemble({
    db, sender, runDate: "2026-10-12", dateLong: "Monday, October 12, 2026",
    origin: "https://example.com", productName: "Morning Briefing",
    sessionSecret: "test-secret", templateText, nowSec,
  });
  assert.equal(r.sent, 2);
  const byTo = Object.fromEntries(sent.map((m) => [m.to, m.html]));
  // Dark user: no light tokens remain; dark surfaces present.
  assert.doesNotMatch(byTo["dark@x.com"], /#ffffff|#101418|#0e2a47|#f4f6f8/i);
  assert.match(byTo["dark@x.com"], /#152a44/);
  // Light user: authored palette untouched.
  assert.match(byTo["pat@x.com"], /#ffffff/);
  assert.doesNotMatch(byTo["pat@x.com"], /#152a44/);
});
